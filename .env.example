# Copy to .env.local and fill in real values. NEVER commit .env / .env.local.
# This file lists variable NAMES only (no secrets).

# --- Site / SEO ---
# Production origin, used for canonical URLs, OpenGraph, sitemap.xml and robots.
# e.g. https://app.your-domain.com. On Vercel it falls back to the project's
# production domain; locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional, defaults to gemini-2.5-flash
# Cost guardrails on /api/ai (optional, safe defaults). Per-minute burst and a
# per-user (or per-IP) daily quota, so no single account can drain the budget.
# AI_RATE_LIMIT=120        # requests per minute
# AI_DAILY_LIMIT=300       # requests per day

# --- Database (Supabase Postgres) ---
# When set, the app stores users + documents in Postgres instead of .data/*.json.
# Use Supabase's POOLED / transaction connection string (Supavisor, port 6543)
# for serverless. Leave empty for local file-store mode.
DATABASE_URL=

# --- Authentication (Auth.js / NextAuth) ---
# Generate a secret: npx auth secret
AUTH_SECRET=
# Google OAuth (optional - Google sign-in only appears when both are set).
# Add redirect URIs in Google for both ports:
#   http://localhost:3001/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (test mode) - https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret - from the Stripe dashboard webhook endpoint. Required
# for server-side entitlement (/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=
# Customer Portal configuration id, from `node scripts/stripe-portal-config.mjs`.
# This is how a customer cancels. Optional: unset, the portal uses the account's
# dashboard default instead. Set it per mode - test and live ids differ.
STRIPE_PORTAL_CONFIGURATION_ID=

# --- Jobs (Adzuna, optional) - https://developer.adzuna.com ---
# Without these the jobs search falls back to the keyless Remotive source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us        # optional, defaults to us

# --- Dropbox Chooser (optional) - https://www.dropbox.com/developers/apps ---
NEXT_PUBLIC_DROPBOX_APP_KEY=

# --- Shared rate limiting (Upstash Redis / Vercel KV, optional) ---
# Without these, rate limiting is in-memory (per serverless instance). Set both
# to enforce the limit GLOBALLY across instances. Vercel KV also exposes these
# REST vars. https://upstash.com  or Vercel -> Storage -> KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error monitoring (Sentry, optional) - https://sentry.io ---
# All Sentry code is inert until these are set. SENTRY_DSN = server; the
# NEXT_PUBLIC_ one = browser. They can be the same project DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Ties an error to the deploy that caused it. Without a release every stack
# trace is filed against "unknown" and a regression cannot be dated. On Vercel
# the commit SHA is picked up automatically, so these are only for other hosts.
# SENTRY_RELEASE=
# NEXT_PUBLIC_SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# --- Product analytics (PostHog, optional) - https://posthog.com ---
# CONSENT-GATED: nothing is loaded or sent until the visitor allows analytics on
# the cookie banner, so setting this key does not start tracking on its own.
# Still read docs/observability.md before setting it in production - adding any
# NEW third-party script needs a consent category and a privacy-policy entry
# first, not afterwards. Host defaults to US cloud; prefer the EU host for EU
# users.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# --- Transactional email (Resend, optional) - https://resend.com ---
# Email sending is inert until RESEND_API_KEY is set. EMAIL_FROM must be a
# verified-domain sender once you go live (the resend.dev default is test-only).
RESEND_API_KEY=
# EMAIL_FROM=Resume.co <hello@your-domain.com>

# --- Tag manager / GA4 (optional) ---
# BOTH are consent-gated: nothing loads until the visitor allows it on the
# cookie banner (GTM under "advertising", GA4 under "analytics").
# They are MUTUALLY EXCLUSIVE at runtime - if GTM_ID is set, GA4 is left to the
# GTM container and is NOT loaded directly, otherwise every event is counted
# twice. Configure GA4 inside GTM, or set GA_ID alone. Not both routes.
# Note the trade: a tag manager that injects arbitrary third-party scripts and a
# nonce-based script-src CSP are close to mutually exclusive, so adding GTM is a
# decision to defer a strict CSP. See docs/observability.md.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA_ID=

# --- Search console ownership (optional) ---
# Needed before Google / Bing will show indexing data or accept a sitemap.
# Omitted from the page entirely when unset - an empty verification tag is worse
# than none, because it looks configured.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# --- Sentry source maps (optional, CI only) ---
# Without these Sentry still reports errors; the stack traces are just minified.
# Upload runs as a separate step - next.config is deliberately NOT wrapped in
# withSentryConfig (see AGENTS.md). Run: npm run sentry:sourcemaps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Rate limits (optional; sensible defaults in code) ---
# All of these are per-instance in memory unless UPSTASH_REDIS_* is configured,
# in which case they hold globally across serverless instances.
# LOGIN_RATE_LIMIT=5               # failed sign-ins per email per 15 min
# REGISTER_RATE_LIMIT=10           # signups per IP per minute
# CHECKOUT_RATE_LIMIT=10           # checkout sessions per account per minute
# EXPORT_RATE_LIMIT=60             # export authorizations per account per minute
# PASSWORD_RESET_IP_LIMIT=10       # reset requests per IP per hour
# PASSWORD_RESET_EMAIL_LIMIT=3     # reset emails per account per hour
# PASSWORD_RESET_ATTEMPT_LIMIT=20  # reset attempts per IP per 15 min
# EMAIL_VERIFY_RESEND_LIMIT=3      # verification emails per account per hour
# EMAIL_VERIFY_ATTEMPT_LIMIT=20    # confirm attempts per IP per 15 min

# --- Proxy trust (optional) ---
# How many proxies in front of the app append to x-forwarded-for. 1 is correct
# for a normal Vercel/Netlify/Cloudflare deploy. Each extra hop you claim is one
# more entry an attacker is allowed to forge, so only raise this if you really
# added a trusted proxy. See src/permissions/rate-limit.ts.
# TRUSTED_PROXY_HOPS=1

# Set by the platform, listed so nobody hunts for them: NODE_ENV, NEXT_RUNTIME,
# VERCEL_GIT_COMMIT_SHA, NEXT_PUBLIC_VERCEL_GIT_COMMIT_SHA,
# VERCEL_PROJECT_PRODUCTION_URL.

