# Copy to .env.local and fill in real values. NEVER commit .env / .env.local.
# This file lists variable NAMES only (no secrets).

# --- Site / SEO ---
# Production origin, used for canonical URLs, OpenGraph, sitemap.xml and robots.
# e.g. https://app.your-domain.com. On Vercel it falls back to the project's
# production domain; locally it defaults to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# --- AI (Google Gemini) ---
GEMINI_API_KEY=
# GEMINI_MODEL=            # optional, defaults to gemini-2.5-flash
# Cost guardrails on /api/ai (optional, safe defaults). Per-minute burst and a
# per-user (or per-IP) daily quota, so no single account can drain the budget.
# AI_RATE_LIMIT=120        # requests per minute
# AI_DAILY_LIMIT=300       # requests per day

# --- Database (Supabase Postgres) ---
# When set, the app stores users + documents in Postgres instead of .data/*.json.
# Use Supabase's POOLED / transaction connection string (Supavisor, port 6543)
# for serverless. Leave empty for local file-store mode.
DATABASE_URL=

# --- Authentication (Auth.js / NextAuth) ---
# Generate a secret: npx auth secret
AUTH_SECRET=
# Google OAuth (optional - Google sign-in only appears when both are set).
# Add redirect URIs in Google for both ports:
#   http://localhost:3001/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (test mode) - https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret - from the Stripe dashboard webhook endpoint. Required
# for server-side entitlement (/api/stripe/webhook).
STRIPE_WEBHOOK_SECRET=

# --- Jobs (Adzuna, optional) - https://developer.adzuna.com ---
# Without these the jobs search falls back to the keyless Remotive source.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us        # optional, defaults to us

# --- Dropbox Chooser (optional) - https://www.dropbox.com/developers/apps ---
NEXT_PUBLIC_DROPBOX_APP_KEY=

# --- Shared rate limiting (Upstash Redis / Vercel KV, optional) ---
# Without these, rate limiting is in-memory (per serverless instance). Set both
# to enforce the limit GLOBALLY across instances. Vercel KV also exposes these
# REST vars. https://upstash.com  or Vercel -> Storage -> KV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Error monitoring (Sentry, optional) - https://sentry.io ---
# All Sentry code is inert until these are set. SENTRY_DSN = server; the
# NEXT_PUBLIC_ one = browser. They can be the same project DSN.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Product analytics (PostHog, optional) - https://posthog.com ---
# Analytics is inert until the key is set. Host defaults to US cloud.
NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com   # or https://eu.i.posthog.com

# --- Transactional email (Resend, optional) - https://resend.com ---
# Email sending is inert until RESEND_API_KEY is set. EMAIL_FROM must be a
# verified-domain sender once you go live (the resend.dev default is test-only).
RESEND_API_KEY=
# EMAIL_FROM=Resume.co <hello@your-domain.com>
