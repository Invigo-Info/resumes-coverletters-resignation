# Copy to .env.local and add your key
GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.0-flash

# --- Authentication (Auth.js / NextAuth) ---
# Generate a secret: npx auth secret  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET=your_auth_secret_here
# Google OAuth — https://console.cloud.google.com/apis/credentials
# App runs on port 3001. Add BOTH redirect URIs in Google so it works on either port:
#   http://localhost:3001/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Stripe (test mode) — https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- Dropbox Chooser — https://www.dropbox.com/developers/apps ---
# App key for the Dropbox Chooser. Add localhost:3001 to the app's Chooser domains.
NEXT_PUBLIC_DROPBOX_APP_KEY=
